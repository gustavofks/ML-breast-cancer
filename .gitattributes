# Scripts de shell rodam no Linux do WSL e do container: com core.autocrlf=true,
# o Git os entregaria com CRLF no Windows, e o bash quebra no "\r" do fim de linha.
*.sh text eol=lf

# Protocolos e conjuntos sao lidos no WSL e no container: o cabecalho dos
# protocolos e separado por linhas "---" e cada registro JSON ocupa uma linha.
# Com CRLF, o cabecalho quebraria e o mesmo arquivo teria bytes diferentes.
data/clinica/** text eol=lf
